{% macro card(title, text, link) %}
<div class="card mb-3">
            <div class="row no-gutters">
                <div class="col-md-2">
                    <img src="https://picsum.photos/100/100" class="card-img" alt="...">
                </div>
                <div class="col-md-10">
                    <div class="card-body">
                        <h3 class="card-title">{{ title }}</h3>
                        <p class="card-text">{{ text }}</p>
                        <p class="card-text"><small class="text-muted">Last updated 3 mins ago</small></p>
                    </div>
                </div>
            </div>
        </div>
        {% endmacro %}