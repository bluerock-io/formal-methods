---
layout: main.liquid
---

<main>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ title }}</h5>
                        <p class="card-text">{{ description }}</p>
                        <a href="{{ page.download_link }}" class="btn btn-primary">Download</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <a href="{{ page.download_link }}"><img src="placeholder.jpg" alt="Card Image" class="img-fluid rounded" /></a>
            </div>
        </div>
    </div>
</main>
